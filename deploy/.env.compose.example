# Copied to deploy/.env.compose on the VM on first deploy. Nothing here is secret.

# Image to run. CI overrides this per deploy with the commit-SHA tag.
SITE_IMAGE=ghcr.io/jagritvats/personalwebsite:main

# Shared Traefik network owned by the Synpse stack.
TRAEFIK_NETWORK=synapse-edge

# Traefik v3 rules. For several hosts use ||, never a comma:
#   Host(`jagritvats.com`) || Host(`me.jagritvats.com`)
SITE_HOST_RULE=Host(`jagritvats.com`)
SITE_WWW_HOST_RULE=Host(`www.jagritvats.com`)
