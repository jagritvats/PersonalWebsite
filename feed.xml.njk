---
permalink: /feed.xml
eleventyExcludeFromCollections: true
eleventyImport:
  collections: ["posts"]
---
{%- set feedUrl = site.url + "/feed.xml" -%}
{%- set writingUrl = site.url + "/writing/" -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang }}">
	<title>{{ site.writing.title }} by {{ profile.name }}</title>
	<subtitle>{{ site.writing.description }}</subtitle>
	<link href="{{ feedUrl }}" rel="self" type="application/atom+xml" />
	<link href="{{ writingUrl }}" rel="alternate" type="text/html" />
	<updated>{{ collections.posts | getNewestCollectionItemDate(site.buildDate) | dateToRfc3339 }}</updated>
	<id>{{ writingUrl }}</id>
	<author>
		<name>{{ profile.name }}</name>
		<uri>{{ profile.url }}</uri>
	</author>
	<icon>{{ site.url }}/favicon.svg</icon>
{%- for post in collections.posts | eleventyFeedHead(20) %}
	{%- set postUrl = site.url + post.url %}
	<entry>
		<title>{{ post.data.title }}</title>
		<link href="{{ postUrl }}" rel="alternate" type="text/html" />
		<id>{{ postUrl }}</id>
		<published>{{ post.date | dateToRfc3339 }}</published>
		<updated>{{ (post.data.updated or post.date) | dateToRfc3339 }}</updated>
		{%- if post.data.description %}
		<summary>{{ post.data.description }}</summary>
		{%- endif %}
		<content type="html">{{ post.content | renderTransforms(post.data.page, site.url + "/") }}</content>
	</entry>
{%- endfor %}
</feed>
