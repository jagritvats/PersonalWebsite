---
layout: layouts/base.njk
pageType: post
---
			<article class="post" aria-labelledby="post-title">
				<header class="post__head" id="top">
					<p class="post__kicker"><a href="/writing/">Writing</a></p>
					<h1 class="post__title" id="post-title">{{ title }}</h1>
					<p class="post__meta">
						<time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
						{%- if updated %}, updated <time datetime="{{ updated | isoDate }}">{{ updated | readableDate }}</time>{% endif %}
					</p>
					{%- if draft %}
					<p class="post__draft">Draft. Left out of production builds.</p>
					{%- endif %}
				</header>

				<div class="post__body">
{{ content | safe }}
				</div>

				{%- set postUrl = site.url + page.url %}
				<aside class="share" aria-labelledby="share-title" data-share-url="{{ postUrl }}" data-share-title="{{ title }}">
					<h2 class="share__title" id="share-title">Share this post</h2>
					<ul class="share__list">
						{#- The two buttons need JS (script.js shows them); the links work without it. #}
						<li><button class="share__button" type="button" data-share-native hidden>Share…</button></li>
						<li><button class="share__button" type="button" data-share-copy hidden>Copy link</button></li>
						<li><a href="https://www.linkedin.com/sharing/share-offsite/?url={{ postUrl | urlencode }}" target="_blank" rel="noopener">LinkedIn</a></li>
						<li><a href="https://x.com/intent/post?url={{ postUrl | urlencode }}&amp;text={{ title | urlencode }}" target="_blank" rel="noopener">X</a></li>
						<li><a href="https://news.ycombinator.com/submitlink?u={{ postUrl | urlencode }}&amp;t={{ title | urlencode }}" target="_blank" rel="noopener">Hacker News</a></li>
						<li><a href="mailto:?subject={{ title | urlencode }}&amp;body={{ postUrl | urlencode }}">Email</a></li>
					</ul>
					<p class="share__status" role="status" aria-live="polite"></p>
					<p class="share__reply">
						Spotted a mistake or have a question?
						<!--email_off--><a href="mailto:{{ profile.email }}?subject={{ ('Re: ' + title) | urlencode }}">Email me</a><!--/email_off-->.
					</p>
				</aside>

				<footer class="post__foot">
					<a href="/writing/">All writing</a>
					<a href="/feed.xml">Atom feed</a>
				</footer>
			</article>
