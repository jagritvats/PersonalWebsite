# Only _site from the build stage reaches the final image (see deploy/Dockerfile),
# and eleventy.config.js decides what goes into _site. This file just keeps the
# build context small and stops local builds leaking in.
.git
.github
.vscode
.claude
node_modules
_site
*.log
README.md
deploy/*
!deploy/nginx.conf
!deploy/security-headers.conf
